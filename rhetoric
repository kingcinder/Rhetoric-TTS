#!/usr/bin/env bash
# Rhetoric - one-stop manager for Linux/macOS.
#
#   ./rhetoric install     set up the venv, register launchers, verify (doctor)
#   ./rhetoric start       launch the desktop GUI
#   ./rhetoric update      refresh an existing install (keeps Input/, Seashells/,
#                        Profiles/, Output/, and your saved settings)
#   ./rhetoric uninstall   remove launchers and the local venv
#
# Each command delegates to the same managed installer the per-action scripts
# use, so behavior matches install_rhetoric.sh / run_rhetoric.sh exactly.

set -Eeuo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

select_python() {
  local candidate
  for candidate in python3.12 python3.11 python3; do
    if ! command -v "$candidate" >/dev/null 2>&1; then
      continue
    fi
    if "$candidate" - <<'PY' >/dev/null 2>&1
import sys
raise SystemExit(0 if (3, 11) <= sys.version_info[:3] < (3, 13) else 1)
PY
    then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

show_help() {
  cat <<'EOF'
Rhetoric - manager

  ./rhetoric install      Set up the venv, register launchers, run the doctor.
  ./rhetoric start        Launch the desktop GUI.
  ./rhetoric update       Refresh an existing install (your data is kept).
  ./rhetoric uninstall    Remove launchers and the local venv.
  ./rhetoric doctor       Diagnostics only.
  ./rhetoric bootstrap    Venv + dependencies without desktop integration.
  ./rhetoric help         Show this message.

EOF
}

main() {
  local action="${1:-help}"
  case "$action" in
    install|start|update|uninstall|doctor|bootstrap|run|gui)
      shift || true
      ;;
    help|-h|--help)
      show_help
      exit 0
      ;;
    *)
      echo "Unknown action: $action" >&2
      show_help >&2
      exit 1
      ;;
  esac

  if [ "$action" = "start" ] || [ "$action" = "gui" ]; then
    action="run"
  fi

  local python_bin
  if ! python_bin="$(select_python)"; then
    printf 'FAIL: Need Python 3.11 or 3.12 with venv support.\n' >&2
    exit 1
  fi
  exec "$python_bin" "$REPO_ROOT/scripts/manage_install.py" "$action" "$@"
}

main "$@"
