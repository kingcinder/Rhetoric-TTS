[Desktop Entry]
Type=Application
Version=1.0
Name=Install Rhetoric
GenericName=Text-to-speech engine installer
Comment=Install Rhetoric (double-click, follow the prompts)
Icon=rhetoric-install
Exec=sh -c 'exec "$(dirname "%k")/_launcher.sh" install'
Terminal=true
Categories=AudioVideo;Audio;
Keywords=tts;text to speech;voice;install;setup;
StartupNotify=false
