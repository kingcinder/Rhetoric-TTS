[Desktop Entry]
Type=Application
Version=1.0
Name=Uninstall Rhetoric
GenericName=Text-to-speech engine uninstaller
Comment=Remove Rhetoric service, files and user
Icon=rhetoric-uninstall
Exec=sh -c 'exec "$(dirname "%k")/_launcher.sh" uninstall'
Terminal=true
Categories=AudioVideo;Audio;
Keywords=tts;text to speech;voice;uninstall;remove;
StartupNotify=false
